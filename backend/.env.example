# Database
DATABASE_URL="postgresql://paperpub:paperpub_dev_password@localhost:5432/publications?schema=public"

# Redis
REDIS_HOST="localhost"
REDIS_PORT=6379
REDIS_PASSWORD=""

# API Keys
IEEE_API_KEY="your-ieee-api-key-here"
SERPAPI_KEY="your-serpapi-key-here"
SEMANTIC_SCHOLAR_API_KEY=""

# JWT
JWT_SECRET="your-super-secret-jwt-key-change-this-in-production"
JWT_EXPIRES_IN="7d"

# Scraping Configuration
SCRAPING_ENABLED=true
SCRAPING_SCHEDULE="0 0 * * 0"
MAX_CONCURRENT_SCRAPERS=3
SCRAPER_TIMEOUT=300000

# Rate Limiting
IEEE_REQUESTS_PER_DAY=200
GOOGLE_SCHOLAR_REQUESTS_PER_HOUR=100
SEMANTIC_SCHOLAR_REQUESTS_PER_SECOND=100

# Institution Configuration
INSTITUTION_NAME="Your College Name"
INSTITUTION_DOMAINS="college.edu,dept.college.edu"
INSTITUTION_ALIASES="YCN,College of Your Name"

# Application
NODE_ENV="development"
PORT=3000
FRONTEND_URL="http://localhost:5173"

# Logging
LOG_LEVEL="debug"
